--============================================================
-- HITBOX ESP
--============================================================

local BodyParts = {

	"Head",

	"UpperTorso",
	"LowerTorso",

	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",

	"RightUpperArm",
	"RightLowerArm",
	"RightHand",

	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",

	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",

	-- R6

	"Torso",
	"Left Arm",
	"Right Arm",
	"Left Leg",
	"Right Leg"
}

local function addHitbox(part)

	if part:FindFirstChild(
		"DeveloperHitbox"
	) then
		return
	end

	local box =
		Instance.new(
			"BoxHandleAdornment"
		)

	box.Name =
		"DeveloperHitbox"

	box.Adornee = part

	box.Size =
		part.Size

	box.Color3 =
		Color3.fromRGB(
			255,
			70,
			70
		)

	box.Transparency = .7
	box.AlwaysOnTop = true
	box.ZIndex = 5

	box.Parent = part
end

local function setupCharacter(character)

	for _, name in ipairs(
		BodyParts
	) do

		local part =
			character:FindFirstChild(
				name
			)

		if part
			and part:IsA("BasePart") then

			addHitbox(part)
		end
	end
end

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	if player.Character then
		setupCharacter(
			player.Character
		)
	end

	player.CharacterAdded:Connect(
		function(character)

			task.wait(.5)

			setupCharacter(
				character
			)
		end
	)
end

for _, player in ipairs(
	Players:GetPlayers()
) do

	setupPlayer(player)
end

Players.PlayerAdded:Connect(
	setupPlayer
)

--============================================================
-- WALL CHECK
--============================================================

local function isVisible(
	character,
	target
)

	if not WallCheck then
		return true
	end

	local origin =
		Camera.CFrame.Position

	local direction =
		target.Position-origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character,
		character
	}

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	return result == nil
end

--============================================================
-- TARGET SELECTION
--============================================================

local function getTarget()

	local mouse =
		UserInputService:GetMouseLocation()

	local closest = nil
	local closestDistance = FOV

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer
			and player.Character then

			if TeamCheck
				and player.Team ==
				LocalPlayer.Team then

				continue
			end

			local humanoid =
				player.Character:
				FindFirstChildOfClass(
					"Humanoid"
				)

			local target =
				player.Character:
				FindFirstChild(
					TargetPart
				)

			if humanoid
				and humanoid.Health > 0
				and target then

				local position,
					onScreen =
					Camera:WorldToViewportPoint(
						target.Position
					)

				if onScreen then

					local distance =
						(
							Vector2.new(
								position.X,
								position.Y
							)
							- mouse
						).Magnitude

					if distance <
						closestDistance then

						if isVisible(
							player.Character,
							target
						) then

							closest =
								target

							closestDistance =
								distance
						end
					end
				end
			end
		end
	end

	return closest
end

--============================================================
-- AIM / WEAPON DIRECTION
--============================================================

local function aimAt(target)

	if not target then
		return
	end

	local origin =
		Camera.CFrame.Position

	local direction =
		(target.Position-origin).Unit

	local desired =
		CFrame.lookAt(
			origin,
			origin+direction
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desired,
			AimStrength
		)
end

--============================================================
-- MAIN LOOP
--============================================================

RunService.RenderStepped:Connect(
	function()

		-- FOV circle

		FOVCircle.Size =
			UDim2.fromOffset(
				FOV*2,
				FOV*2
			)

		-- ESP

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer
				and player.Character then

				for _, name in ipairs(
					BodyParts
				) do

					local part =
						player.Character:
						FindFirstChild(
							name
						)

					if part then

						local box =
							part:FindFirstChild(
								"DeveloperHitbox"
							)

						if box then

							box.Visible =
								ESPEnabled
						end
					end
				end
			end
		end

		-- Aim

		if AimEnabled then

			local target =
				getTarget()

			if target then
				aimAt(target)
			end
		end
	end
)
