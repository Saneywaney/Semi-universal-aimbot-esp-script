local fovDragging = false

local function updateFOV(x)

	local start =
		FOVSlider.AbsolutePosition.X

	local width =
		FOVSlider.AbsoluteSize.X

	local percent =
		math.clamp(
			(x-start)/width,
			0,
			1
		)

	FOV =
		math.floor(
			25 + percent*375
		)

	FOVLabel.Text =
		"FOV: "..FOV

	FOVKnob.Position =
		UDim2.new(
			percent,
			0,
			.5,
			0
		)
end

FOVSlider.MouseButton1Down:Connect(function()

	fovDragging = true

	updateFOV(
		UserInputService:GetMouseLocation().X
	)
end)

